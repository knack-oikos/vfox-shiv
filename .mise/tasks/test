#!/usr/bin/env bash
#MISE description="Run BATS tests"
#USAGE arg "[args]..." var=#true help="Test suites or bats arguments"
#USAGE example "mise run test" header="Run all tests"
#USAGE example "mise run test install" header="Run a specific suite by name"
#USAGE example "mise run test test/errors.bats" header="Run a specific file"
#USAGE example "mise run test -- --filter rejects" header="Filter tests by name"
set -euo pipefail

repo_dir="$(cd "${MISE_CONFIG_ROOT:?run this task through mise}" && pwd)"
test_dir="$repo_dir/test"
bats_bin="$(command -v bats)"
export VFOX_SHIV_TEST_LUA_BIN="$(command -v lua)"

source "$test_dir/mise_isolation.bash"
setup_mise_test_isolation "$repo_dir"

args=()
has_target=false
for arg in "$@"; do
  if [[ "$arg" != -* && "$arg" != *.bats && -f "$test_dir/$arg.bats" ]]; then
    args+=("$test_dir/$arg.bats")
    has_target=true
  else
    [[ "$arg" == *.bats || -d "$arg" ]] && has_target=true
    args+=("$arg")
  fi
done

if ! $has_target; then
  args+=("$test_dir/")
fi

"$bats_bin" "${args[@]}"
